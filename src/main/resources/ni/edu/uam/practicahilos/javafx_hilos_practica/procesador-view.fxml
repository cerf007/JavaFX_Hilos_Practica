<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.practicahilos.javafx_hilos_practica.ProcesadorController"
      alignment="CENTER"
      spacing="18"
      prefWidth="560"
      prefHeight="500">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Monitor de procesos"
           style="-fx-font-size: 22px;"/>

    <VBox spacing="8"
          style="-fx-border-color: #c9c9c9;
                 -fx-border-radius: 6;
                 -fx-background-radius: 6;
                 -fx-padding: 12;">

        <Label text="Clientes (100 registros)"
               style="-fx-font-weight: bold;"/>

        <Label fx:id="lblEstadoClientes"
               text="Esperando inicio"/>

        <ProgressBar fx:id="barraClientes"
                     progress="0"
                     prefWidth="480"/>

        <Label fx:id="lblPorcentajeClientes"
               text="0%"/>

        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="btnIniciarClientes"
                    text="Iniciar clientes"
                    onAction="#iniciarClientes"/>

            <Button fx:id="btnDetenerClientes"
                    text="Detener clientes"
                    onAction="#detenerClientes"
                    disable="true"/>
        </HBox>
    </VBox>

    <VBox spacing="8"
          style="-fx-border-color: #c9c9c9;
                 -fx-border-radius: 6;
                 -fx-background-radius: 6;
                 -fx-padding: 12;">

        <Label text="Productos (50 registros)"
               style="-fx-font-weight: bold;"/>

        <Label fx:id="lblEstadoProductos"
               text="Esperando inicio"/>

        <ProgressBar fx:id="barraProductos"
                     progress="0"
                     prefWidth="480"/>

        <Label fx:id="lblPorcentajeProductos"
               text="0%"/>

        <HBox alignment="CENTER" spacing="10">
            <Button fx:id="btnIniciarProductos"
                    text="Iniciar productos"
                    onAction="#iniciarProductos"/>

            <Button fx:id="btnDetenerProductos"
                    text="Detener productos"
                    onAction="#detenerProductos"
                    disable="true"/>
        </HBox>
    </VBox>

    <Button fx:id="btnReiniciar"
            text="Reiniciar todo"
            onAction="#reiniciarProceso"/>
</VBox>